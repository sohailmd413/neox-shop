{
  "description": "Every 5 minutes, picks up scheduled campaigns whose send time has arrived and sends them to opted-in customers in their preferred language.",
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "campaign_sender",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "send_due": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "processScheduledCampaigns"
          },
          "then": "end",
          "x-base44": {
            "title": "Send due campaigns",
            "description": "Every 5 minutes"
          }
        }
      }
    ]
  },
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "*/5 * * * *",
      "one_time_date": null,
      "timezone": "Asia/Riyadh",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "name": "Campaign Sender"
}