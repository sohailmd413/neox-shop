{
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "expire_posters",
      "version": "1",
      "namespace": "base44"
    },
    "do": [
      {
        "expire": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "expirePosters",
            "args": {}
          },
          "then": "end",
          "x-base44": {
            "title": "Expire posters",
            "description": "Deactivate banners past their scheduled end time"
          }
        }
      }
    ]
  },
  "description": "Every day at midnight, deactivates banners whose end time has passed so they stop serving on the storefront.",
  "name": "Expire Posters",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 0 * * *",
      "one_time_date": null,
      "timezone": "Asia/Riyadh",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  }
}