{
  "name": "Back in Stock Alerts",
  "description": "When a product is updated to in stock, email customers who asked to be notified and mark their StockAlerts sent.",
  "trigger": {
    "condition": "${ (.trigger.data.stock // 0) > 0 }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "update"
      ],
      "entity_name": "Product"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "back_in_stock_alerts",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "notify": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "processRestock",
            "args": {
              "product_id": "${ .trigger.entity_id }"
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Notify back-in-stock subscribers"
          }
        }
      }
    ]
  }
}