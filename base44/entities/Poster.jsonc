{
  "name": "Poster",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "Internal reference name for the banner."
    },
    "brand_name": {
      "type": "string",
      "description": "Brand or collection this banner promotes, e.g. 'NeoX Essentials', 'FlexFit'. Leave blank for seasonal banners with no specific brand tie. Shown as a small watermark on the banner when set."
    },
    "brand_logo_url": {
      "type": "string",
      "description": "Optional small brand logo shown as a bottom-corner watermark on the banner."
    },
    "sponsor_type": {
      "type": "string",
      "enum": [
        "in_house",
        "brand_partner",
        "seasonal"
      ],
      "default": "in_house",
      "description": "in_house=your own store's promotion; brand_partner=a specific vendor/brand campaign; seasonal=a general sale or seasonal event with no specific brand tie. Used to categorize and filter banners by purpose."
    },
    "campaign_name": {
      "type": "string",
      "description": "Internal-only campaign label for admin organization/tracking, e.g. 'Autumn Sale 2026'. Not shown publicly on the storefront."
    },
    "image_url": {
      "type": "string",
      "description": "Desktop banner image (recommended 1920x600px). Optional for text-first slots (top_ribbon, in_grid, sticky_bar)."
    },
    "image_mobile_url": {
      "type": "string",
      "description": "Mobile banner image (recommended 800x1000px). Falls back to image_url when not set."
    },
    "alt_text": {
      "type": "string",
      "description": "Alt text for SEO/accessibility."
    },
    "link_url": {
      "type": "string",
      "description": "Legacy plain link; superseded by cta_link but kept for compatibility."
    },
    "tagline": {
      "type": "string",
      "description": "Tagline overlay text (English)."
    },
    "tagline_ar": {
      "type": "string",
      "description": "Arabic tagline overlay text shown when Arabic is selected. Required before publishing the poster if an English tagline is set."
    },
    "animation": {
      "type": "string",
      "enum": [
        "none",
        "marquee",
        "fade",
        "slide",
        "typewriter"
      ],
      "default": "none",
      "description": "Tagline animation type."
    },
    "animation_direction": {
      "type": "string",
      "enum": [
        "left",
        "right"
      ],
      "default": "left",
      "description": "Marquee scroll direction."
    },
    "animation_speed": {
      "type": "string",
      "enum": [
        "slow",
        "medium",
        "fast"
      ],
      "default": "medium"
    },
    "text_position": {
      "type": "string",
      "enum": [
        "top",
        "center",
        "bottom"
      ],
      "default": "center"
    },
    "text_align": {
      "type": "string",
      "enum": [
        "left",
        "center",
        "right"
      ],
      "default": "center"
    },
    "font_size": {
      "type": "number",
      "default": 0,
      "description": "Tagline font size in px; 0 uses a sensible default per device."
    },
    "font_color": {
      "type": "string",
      "description": "CSS color for the tagline text."
    },
    "font_weight": {
      "type": "string",
      "enum": [
        "normal",
        "bold"
      ],
      "default": "bold"
    },
    "strip_bg": {
      "type": "boolean",
      "default": false,
      "description": "Show a semi-transparent strip behind the tagline for readability."
    },
    "cta_text": {
      "type": "string",
      "description": "Call-to-action button label (English)."
    },
    "cta_text_ar": {
      "type": "string",
      "description": "Arabic call-to-action button label shown when Arabic is selected. Required before publishing the poster if an English cta_text is set."
    },
    "cta_link": {
      "type": "string",
      "description": "Call-to-action destination URL."
    },
    "cta_color": {
      "type": "string",
      "description": "Call-to-action button background color."
    },
    "page": {
      "type": "string",
      "enum": [
        "home",
        "category",
        "catalog",
        "product_detail",
        "cart",
        "checkout",
        "search",
        "splash",
        "custom"
      ],
      "default": "home"
    },
    "zone": {
      "type": "string",
      "enum": [
        "hero",
        "secondary",
        "sidebar",
        "mid_strip",
        "grid_interstitial",
        "footer",
        "popup",
        "sticky_bar",
        "top_ribbon",
        "in_grid"
      ],
      "default": "hero"
    },
    "category_ref": {
      "type": "string",
      "description": "When page=category, the target Category id."
    },
    "device": {
      "type": "string",
      "enum": [
        "both",
        "desktop",
        "mobile"
      ],
      "default": "both"
    },
    "start_at": {
      "type": "string",
      "format": "date-time"
    },
    "end_at": {
      "type": "string",
      "format": "date-time"
    },
    "active": {
      "type": "boolean",
      "default": true
    },
    "sort_order": {
      "type": "number",
      "default": 0,
      "description": "Rotation/priority order within a slot (lower shows first)."
    },
    "target_audience": {
      "type": "string",
      "enum": [
        "all",
        "new",
        "logged_in"
      ],
      "default": "all"
    },
    "impressions": {
      "type": "number",
      "default": 0
    },
    "clicks": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "title"
  ],
  "rls": {
    "read": true,
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "marketing_manager"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "marketing_manager"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "marketing_manager"
          }
        }
      ]
    }
  }
}