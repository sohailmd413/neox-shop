{
  "name": "Role",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Unique role key (lowercase, single token). Stored on user.role."
    },
    "label": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "permissions": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "enum": [
          "allow",
          "deny"
        ]
      },
      "description": "Default section access: section id -> 'allow' or 'deny'. Omitted keys inherit to no access."
    }
  },
  "required": [
    "name",
    "label"
  ],
  "rls": {
    "read": true,
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}