{
  "name": "Setting",
  "type": "object",
  "properties": {
    "key": {
      "type": "string",
      "description": "Singleton key, e.g. 'store'. Always 'store' for the single settings record."
    },
    "store_name": {
      "type": "string",
      "description": "Store display name (English)."
    },
    "store_name_ar": {
      "type": "string",
      "description": "Store display name (Arabic). Required for the Arabic storefront."
    },
    "logo_url": {
      "type": "string",
      "description": "Primary store logo shown in the header (on light backgrounds). Use a transparent PNG/SVG."
    },
    "footer_logo_url": {
      "type": "string",
      "description": "Optional footer logo shown on the dark navy footer. Falls back to logo_url when not set. Use a white/transparent PNG/SVG suitable for dark backgrounds."
    },
    "contact_email": {
      "type": "string"
    },
    "contact_phone": {
      "type": "string"
    },
    "business_address": {
      "type": "string",
      "description": "Business address (English)."
    },
    "business_address_ar": {
      "type": "string",
      "description": "Business address (Arabic). Required for the Arabic storefront."
    },
    "business_hours": {
      "type": "string",
      "description": "Free-text business hours, e.g. 'Sat\u2013Thu, 9am\u20139pm'."
    },
    "tax_id": {
      "type": "string",
      "description": "VAT / tax registration number shown on invoices."
    },
    "currency": {
      "type": "string",
      "default": "SAR",
      "description": "ISO currency code used for price formatting."
    },
    "currency_symbol": {
      "type": "string",
      "default": "\ufdfc"
    },
    "default_language": {
      "type": "string",
      "enum": [
        "en",
        "ar"
      ],
      "default": "en"
    },
    "payment_methods_enabled": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "card",
          "cod",
          "wallet",
          "upi",
          "net_banking"
        ]
      },
      "default": [
        "card",
        "cod"
      ]
    },
    "shipping_zones": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "regions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "rate": {
            "type": "number"
          },
          "free_shipping_threshold": {
            "type": "number"
          }
        }
      },
      "default": []
    },
    "tax_rules": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "region": {
            "type": "string"
          },
          "rate": {
            "type": "number"
          },
          "inclusive": {
            "type": "boolean",
            "default": false
          }
        }
      },
      "default": []
    },
    "loyalty_program_enabled": {
      "type": "boolean",
      "default": false,
      "description": "Master toggle for the loyalty program. When off, the account Loyalty tab and checkout redemption UI are hidden, and no points are earned or redeemed."
    },
    "loyalty_points_per_currency_unit": {
      "type": "number",
      "description": "Currency amount a customer must spend to earn 1 point. E.g. 10 = 1 point per SAR 10 spent. Points are earned on the order merchandise subtotal after discounts, excluding tax and shipping."
    },
    "loyalty_redeem_points": {
      "type": "number",
      "description": "Points required for one redemption unit. Paired with loyalty_redeem_amount. E.g. 100 points = the amount below."
    },
    "loyalty_redeem_amount": {
      "type": "number",
      "description": "SAR discount value of one redemption unit. E.g. 5 = 100 points are worth SAR 5 off."
    },
    "loyalty_expiry_days": {
      "type": "number",
      "description": "If set, earned points expire this many days after they were earned. Leave blank/null to disable expiry. A daily workflow creates expired transactions for aged, unredeemed points."
    },
    "referral_program_enabled": {
      "type": "boolean",
      "default": false,
      "description": "Master toggle for the refer-a-friend program. When off, the account Referrals tab shows an inactive message and no referrals are created or rewarded."
    },
    "referrer_reward_type": {
      "type": "string",
      "enum": [
        "loyalty_points",
        "coupon"
      ],
      "default": "loyalty_points",
      "description": "How the referrer is rewarded when their friend's first order qualifies. loyalty_points credits points to their balance; coupon generates a single-use fixed-amount coupon scoped to them."
    },
    "referrer_reward_value": {
      "type": "number",
      "description": "Magnitude of the referrer reward: number of points (if loyalty_points) or SAR amount (if coupon)."
    },
    "referred_reward_type": {
      "type": "string",
      "enum": [
        "loyalty_points",
        "coupon"
      ],
      "default": "coupon",
      "description": "How the referred friend is rewarded at signup. coupon is the default since a fresh account has no points balance yet \u2014 it gives them a first-order discount."
    },
    "referred_reward_value": {
      "type": "number",
      "description": "Magnitude of the referred friend's reward: number of points (if loyalty_points) or SAR amount (if coupon)."
    },
    "min_qualifying_order_value": {
      "type": "number",
      "default": 0,
      "description": "The referred friend's first delivered order must total at least this much (after discounts, before tax/shipping) to qualify the referral for the referrer reward."
    },
    "referral_code_expiry_days": {
      "type": "number",
      "description": "If set, a registered referral that has not produced a qualifying delivered order within this many days of registration is marked expired (no referrer reward). Blank/null disables expiry."
    },
    "abandoned_cart_recovery_enabled": {
      "type": "boolean",
      "default": false,
      "description": "Master toggle for abandoned-cart recovery. When off, no carts are flagged and no recovery emails are sent."
    },
    "abandoned_cart_delay_hours": {
      "type": "number",
      "default": 1,
      "description": "Hours a cart must sit idle (no edits) with at least one item before it is flagged abandoned and the first reminder becomes due."
    },
    "abandoned_cart_second_reminder_enabled": {
      "type": "boolean",
      "default": false,
      "description": "Send a second recovery nudge after abandoned_cart_second_reminder_hours."
    },
    "abandoned_cart_second_reminder_hours": {
      "type": "number",
      "default": 24,
      "description": "Hours after the first reminder before the second reminder is sent."
    },
    "abandoned_cart_discount_enabled": {
      "type": "boolean",
      "default": false,
      "description": "Include a single-use discount coupon in the second reminder as a recovery incentive."
    },
    "abandoned_cart_discount_percent": {
      "type": "number",
      "default": 10,
      "description": "Percent off offered by the second-reminder recovery coupon."
    },
    "abandoned_cart_respect_opt_out": {
      "type": "boolean",
      "default": false,
      "description": "When off (default), recovery emails are treated as transactional and sent regardless of marketing opt-in (the customer initiated the cart). When on, customers who opted out of marketing are skipped."
    },
    "in_grid_insert_every_n_products": {
      "type": "number",
      "default": 4,
      "description": "Insert an in-grid promotional banner tile after every Nth product in scrollable product grids (Catalog and homepage merchandising sections). 0 or unset defaults to 4."
    },
    "terms_policy": {
      "type": "string",
      "description": "Terms of Service HTML content (English)."
    },
    "terms_policy_ar": {
      "type": "string",
      "description": "Terms of Service HTML content (Arabic). Required so the Arabic policy page shows real content."
    },
    "privacy_policy": {
      "type": "string",
      "description": "Privacy Policy HTML content (English)."
    },
    "privacy_policy_ar": {
      "type": "string",
      "description": "Privacy Policy HTML content (Arabic)."
    },
    "return_policy": {
      "type": "string",
      "description": "Return Policy HTML content (English)."
    },
    "return_policy_ar": {
      "type": "string",
      "description": "Return Policy HTML content (Arabic)."
    },
    "shipping_policy": {
      "type": "string",
      "description": "Shipping Policy HTML content (English)."
    },
    "shipping_policy_ar": {
      "type": "string",
      "description": "Shipping Policy HTML content (Arabic)."
    }
  },
  "required": [
    "key"
  ],
  "rls": {
    "read": true,
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}