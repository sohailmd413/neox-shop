{
  "name": "Setting",
  "type": "object",
  "properties": {
    "key": {
      "type": "string",
      "description": "Singleton key, e.g. 'store'. Always 'store' for the single settings record."
    },
    "store_name": {
      "type": "string",
      "description": "Store display name (English)."
    },
    "store_name_ar": {
      "type": "string",
      "description": "Store display name (Arabic). Required for the Arabic storefront."
    },
    "logo_url": {
      "type": "string",
      "description": "Primary store logo shown in the header (on light backgrounds). Use a transparent PNG/SVG."
    },
    "footer_logo_url": {
      "type": "string",
      "description": "Optional footer logo shown on the dark navy footer. Falls back to logo_url when not set."
    },
    "contact_email": {
      "type": "string"
    },
    "contact_phone": {
      "type": "string"
    },
    "business_address": {
      "type": "string",
      "description": "Business address (English)."
    },
    "business_address_ar": {
      "type": "string",
      "description": "Business address (Arabic). Required for the Arabic storefront."
    },
    "business_hours": {
      "type": "string",
      "description": "Free-text business hours, e.g. 'Sat\u2013Thu, 9am\u20139pm'."
    },
    "tax_id": {
      "type": "string",
      "description": "VAT / tax registration number shown on invoices."
    },
    "currency": {
      "type": "string",
      "default": "SAR",
      "description": "ISO currency code used for price formatting."
    },
    "currency_symbol": {
      "type": "string",
      "default": "\ufdfc"
    },
    "default_language": {
      "type": "string",
      "enum": [
        "en",
        "ar"
      ],
      "default": "en"
    },
    "payment_methods_enabled": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "card",
          "cod",
          "wallet",
          "upi",
          "net_banking"
        ]
      },
      "default": [
        "card",
        "cod"
      ]
    },
    "shipping_zones": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "regions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "rate": {
            "type": "number"
          },
          "free_shipping_threshold": {
            "type": "number"
          }
        }
      },
      "default": []
    },
    "tax_rules": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "region": {
            "type": "string"
          },
          "rate": {
            "type": "number"
          },
          "inclusive": {
            "type": "boolean",
            "default": false
          }
        }
      },
      "default": []
    },
    "loyalty_program_enabled": {
      "type": "boolean",
      "default": false,
      "description": "Master toggle for the loyalty program."
    },
    "loyalty_points_per_currency_unit": {
      "type": "number",
      "description": "Currency amount a customer must spend to earn 1 point."
    },
    "loyalty_redeem_points": {
      "type": "number",
      "description": "Points required for one redemption unit."
    },
    "loyalty_redeem_amount": {
      "type": "number",
      "description": "SAR discount value of one redemption unit."
    },
    "loyalty_expiry_days": {
      "type": "number",
      "description": "If set, earned points expire this many days after they were earned."
    },
    "referral_program_enabled": {
      "type": "boolean",
      "default": false,
      "description": "Master toggle for the refer-a-friend program."
    },
    "referrer_reward_type": {
      "type": "string",
      "enum": [
        "loyalty_points",
        "coupon"
      ],
      "default": "loyalty_points"
    },
    "referrer_reward_value": {
      "type": "number"
    },
    "referred_reward_type": {
      "type": "string",
      "enum": [
        "loyalty_points",
        "coupon"
      ],
      "default": "coupon"
    },
    "referred_reward_value": {
      "type": "number"
    },
    "min_qualifying_order_value": {
      "type": "number",
      "default": 0
    },
    "referral_code_expiry_days": {
      "type": "number",
      "description": "If set, a registered referral with no qualifying order within this many days is marked expired."
    },
    "return_window_days": {
      "type": "number",
      "default": 30,
      "description": "Number of days after delivery during which a customer can request a return for that order."
    },
    "refund_on_approval": {
      "type": "boolean",
      "default": false,
      "description": "When true, the refund is issued at approval (before the item is physically back). When false (default), the admin must mark the item as received before the refund can be processed."
    },
    "return_shipping_instructions": {
      "type": "string",
      "description": "Instructions/address shown to the customer when a return is approved (where to ship the item back)."
    },
    "abandoned_cart_recovery_enabled": {
      "type": "boolean",
      "default": false
    },
    "abandoned_cart_delay_hours": {
      "type": "number",
      "default": 1
    },
    "abandoned_cart_second_reminder_enabled": {
      "type": "boolean",
      "default": false
    },
    "abandoned_cart_second_reminder_hours": {
      "type": "number",
      "default": 24
    },
    "abandoned_cart_discount_enabled": {
      "type": "boolean",
      "default": false
    },
    "abandoned_cart_discount_percent": {
      "type": "number",
      "default": 10
    },
    "abandoned_cart_respect_opt_out": {
      "type": "boolean",
      "default": false
    },
    "in_grid_insert_every_n_products": {
      "type": "number",
      "default": 4
    },
    "terms_policy": {
      "type": "string"
    },
    "terms_policy_ar": {
      "type": "string"
    },
    "privacy_policy": {
      "type": "string"
    },
    "privacy_policy_ar": {
      "type": "string"
    },
    "return_policy": {
      "type": "string"
    },
    "return_policy_ar": {
      "type": "string"
    },
    "shipping_policy": {
      "type": "string"
    },
    "shipping_policy_ar": {
      "type": "string"
    }
  },
  "required": [
    "key"
  ],
  "rls": {
    "read": true,
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}