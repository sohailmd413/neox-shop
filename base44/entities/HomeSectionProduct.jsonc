{
  "name": "HomeSectionProduct",
  "type": "object",
  "properties": {
    "section_id": {
      "type": "string",
      "description": "The HomeSection this pick belongs to."
    },
    "product_id": {
      "type": "string",
      "description": "The product included in the section."
    },
    "sort_order": {
      "type": "number",
      "default": 0,
      "description": "Position of the product within its manual_picks section. Lower shows first."
    }
  },
  "required": [
    "section_id",
    "product_id"
  ],
  "rls": {
    "read": true,
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}