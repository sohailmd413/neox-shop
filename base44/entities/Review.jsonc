{
  "name": "Review",
  "type": "object",
  "properties": {
    "product_id": {
      "type": "string"
    },
    "user_id": {
      "type": "string"
    },
    "rating": {
      "type": "number"
    },
    "title": {
      "type": "string",
      "description": "Optional review headline"
    },
    "comment": {
      "type": "string"
    },
    "photo_urls": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "verified_purchase": {
      "type": "boolean",
      "default": false
    },
    "approved": {
      "type": "boolean",
      "default": false
    },
    "rejected": {
      "type": "boolean",
      "default": false,
      "description": "True when a moderator rejected the review; excluded from the storefront."
    },
    "unpublished": {
      "type": "boolean",
      "default": false,
      "description": "True when a moderator pulled a previously approved review offline; lives in the Unpublished tab, not Pending."
    },
    "deleted": {
      "type": "boolean",
      "default": false,
      "description": "True when a moderator soft-deleted the review; lives in the Deleted tab and is excluded from the storefront."
    },
    "flagged": {
      "type": "boolean",
      "default": false,
      "description": "True when the review was flagged/reported for review (spam, offensive, fake, irrelevant)."
    },
    "flag_reasons": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Report reasons e.g. spam, offensive, fake, irrelevant"
    },
    "helpful_count": {
      "type": "number",
      "default": 0
    },
    "not_helpful_count": {
      "type": "number",
      "default": 0,
      "description": "Count of not-helpful votes"
    },
    "author": {
      "type": "string"
    },
    "admin_reply": {
      "type": "object",
      "properties": {
        "text": {
          "type": "string"
        },
        "author": {
          "type": "string"
        },
        "created_date": {
          "type": "string",
          "format": "date-time"
        }
      },
      "description": "Public merchant reply to the review."
    }
  },
  "required": [
    "product_id",
    "rating"
  ],
  "rls": {
    "read": true,
    "create": true,
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "marketing_manager"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "marketing_manager"
          }
        }
      ]
    }
  }
}