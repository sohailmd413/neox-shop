{
  "name": "ProductImage",
  "type": "object",
  "properties": {
    "product_id": {
      "type": "string"
    },
    "url": {
      "type": "string"
    },
    "alt_text": {
      "type": "string"
    },
    "sort_order": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "product_id",
    "url"
  ],
  "rls": {
    "read": true,
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}