{
  "name": "User",
  "type": "object",
  "properties": {
    "role": {
      "type": "string",
      "description": "Staff role key. Built-in: admin, product_manager, delivery_manager, marketing_manager, user. Custom roles (created in the Roles section) use their own key.",
      "default": "user"
    },
    "permissions": {
      "type": "object",
      "description": "Per-section admin access overrides. Keys are section ids (dashboard, products, categories, orders, reviews, posters); values are 'allow' or 'deny'. The role provides defaults; explicit entries override them."
    },
    "temp_password": {
      "type": "string",
      "description": "Temporary password shared with a staff member at invite time. The platform can't apply it automatically; the staff member must set their own password. Shown to admins in the Staff members list for their reference."
    },
    "display_name": {
      "type": "string",
      "description": "Editable display name chosen by the user (or set by an admin on their behalf). The single source of truth for the user's name everywhere it is shown (admin header, audit trail, storefront account). Falls back to the built-in full_name then email when empty."
    },
    "phone": {
      "type": "string",
      "description": "Contact phone for the user. On customer accounts this is unique across all customers (enforced by the updateCustomerProfile backend function)."
    },
    "phone_verified": {
      "type": "boolean",
      "default": false,
      "description": "True once the phone number has been verified. SMS verification isn't built in yet, so customer phones stay unverified until an SMS gateway is connected."
    },
    "avatar_url": {
      "type": "string",
      "description": "Optional profile photo URL (uploaded via the Profile page). Falls back to the initials circle when empty."
    },
    "timezone": {
      "type": "string",
      "description": "Preferred IANA timezone, e.g. 'Asia/Riyadh'. Used to display dates/times correctly for this user."
    },
    "language": {
      "type": "string",
      "enum": [
        "en",
        "ar"
      ],
      "default": "en",
      "description": "Preferred interface language for this user."
    },
    "date_of_birth": {
      "type": "string",
      "format": "date",
      "description": "Customer date of birth (optional)."
    },
    "gender": {
      "type": "string",
      "enum": [
        "male",
        "female",
        "other",
        "prefer_not_to_say"
      ],
      "description": "Customer gender (optional)."
    },
    "marketing_opt_in": {
      "type": "boolean",
      "default": false,
      "description": "Consent to receive promotional emails/SMS. Toggled from the customer Notification preferences."
    },
    "customer_notifications": {
      "type": "object",
      "description": "Per-customer notification toggles. Promo consent lives in marketing_opt_in.",
      "properties": {
        "order_updates": {
          "type": "boolean",
          "default": true
        },
        "price_drop": {
          "type": "boolean",
          "default": true
        },
        "new_arrivals": {
          "type": "boolean",
          "default": false
        }
      }
    },
    "notification_preferences": {
      "type": "object",
      "description": "Per-staff admin alert toggles. Keys: new_order, low_stock, new_review, approval_assigned, approval_outcome. Values are booleans.",
      "properties": {
        "new_order": {
          "type": "boolean",
          "default": false
        },
        "low_stock": {
          "type": "boolean",
          "default": false
        },
        "new_review": {
          "type": "boolean",
          "default": false
        },
        "approval_assigned": {
          "type": "boolean",
          "default": false
        },
        "approval_outcome": {
          "type": "boolean",
          "default": false
        }
      }
    }
  }
}