{
  "name": "FAQItem",
  "type": "object",
  "properties": {
    "question": {
      "type": "string",
      "description": "The common question shown as a clickable quick-answer in the support widget."
    },
    "question_ar": {
      "type": "string",
      "description": "Arabic question text shown when the site language is Arabic."
    },
    "answer": {
      "type": "string",
      "description": "The answer that expands inline when the question is clicked."
    },
    "answer_ar": {
      "type": "string",
      "description": "Arabic answer shown when Arabic is selected."
    },
    "category": {
      "type": "string",
      "description": "Optional grouping label for the admin list."
    },
    "display_order": {
      "type": "number",
      "default": 0,
      "description": "Sort order in the widget (lower shows first)."
    },
    "active": {
      "type": "boolean",
      "default": true,
      "description": "Only active items appear in the storefront widget."
    }
  },
  "required": [
    "question",
    "answer"
  ],
  "rls": {
    "read": true,
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "marketing_manager"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "marketing_manager"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "marketing_manager"
          }
        }
      ]
    }
  }
}