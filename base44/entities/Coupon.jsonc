{
  "name": "Coupon",
  "type": "object",
  "properties": {
    "code": {
      "type": "string"
    },
    "discount_type": {
      "type": "string",
      "enum": [
        "percent",
        "fixed"
      ],
      "default": "percent"
    },
    "discount_value": {
      "type": "number"
    },
    "starts_at": {
      "type": "string",
      "format": "date-time",
      "description": "Optional activation date. Coupon is not redeemable before this time."
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "usage_limit": {
      "type": "number",
      "description": "Total redemptions allowed across all customers. Blank = unlimited."
    },
    "per_customer_limit": {
      "type": "number",
      "description": "Max redemptions per individual customer. Blank = unlimited per customer."
    },
    "min_order_value": {
      "type": "number",
      "description": "Minimum cart subtotal required to redeem. Blank = no minimum."
    },
    "applicable_product_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "If set, the coupon only applies when the cart contains at least one of these products."
    },
    "applicable_category_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "If set, the coupon only applies when the cart contains at least one product in these categories."
    },
    "owner_customer_id": {
      "type": "string",
      "description": "When set (by the referral reward system), this coupon is scoped to a single customer and validateCoupon rejects it for anyone else. Blank/omit for public coupons."
    },
    "times_used": {
      "type": "number",
      "default": 0
    },
    "active": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "code",
    "discount_type",
    "discount_value"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}