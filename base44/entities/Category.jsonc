{
  "name": "Category",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "name_ar": {
      "type": "string",
      "description": "Arabic display name shown when the site language is Arabic."
    },
    "slug": {
      "type": "string"
    },
    "parent_id": {
      "type": "string",
      "description": "Optional parent category id for subcategories"
    },
    "image_url": {
      "type": "string"
    },
    "sort_order": {
      "type": "number",
      "default": 0
    },
    "meta_title": {
      "type": "string"
    },
    "meta_description": {
      "type": "string"
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "read": true,
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}