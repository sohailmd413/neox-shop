{
  "name": "Category",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "name_ar": {
      "type": "string",
      "description": "Arabic display name shown when the site language is Arabic."
    },
    "slug": {
      "type": "string"
    },
    "parent_id": {
      "type": "string",
      "description": "Optional parent category id for subcategories"
    },
    "image_url": {
      "type": "string",
      "description": "Category icon/thumbnail shown in-tree and on cards. Required before the category can be submitted for approval."
    },
    "banner_image_url": {
      "type": "string",
      "description": "Hero banner image for the category landing page."
    },
    "description": {
      "type": "string",
      "description": "Rich HTML description shown on the category landing page."
    },
    "short_description": {
      "type": "string",
      "description": "Short blurb shown on category cards/tiles."
    },
    "sort_order": {
      "type": "number",
      "default": 0
    },
    "featured": {
      "type": "boolean",
      "default": false,
      "description": "Show this category as featured on the homepage."
    },
    "active": {
      "type": "boolean",
      "default": false,
      "description": "Storefront visibility flag. Only true once the category has been approved. New / draft / pending / rejected categories are inactive."
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "pending_approval",
        "rejected",
        "active"
      ],
      "default": "draft",
      "description": "Approval state. draft=incomplete / not submitted; pending_approval=submitted for admin sign-off; rejected=returned by an approver with a reason, not live and never visible on the storefront (must be fixed and resubmitted through pending_approval); active=approved and live on the storefront. Mirrors the active flag (active=true only when status=active)."
    },
    "show_in_nav": {
      "type": "boolean",
      "default": true,
      "description": "Show this category in the storefront navigation menu."
    },
    "focus_keyword": {
      "type": "string",
      "description": "SEO focus keyword for the category page."
    },
    "meta_title": {
      "type": "string"
    },
    "meta_description": {
      "type": "string"
    },
    "submitted_by": {
      "type": "string",
      "description": "Display name of the staff member who last submitted this category for approval."
    },
    "submitted_by_id": {
      "type": "string",
      "description": "User id of the staff member who last submitted this category for approval."
    },
    "submitted_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the category was last submitted for approval."
    },
    "rejection_reason": {
      "type": "string",
      "description": "Reason entered by the approver the last time this submission was rejected. Cleared on a new submission."
    },
    "approval_history": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "action": {
            "type": "string",
            "enum": [
              "submitted",
              "approved",
              "rejected"
            ]
          },
          "by": {
            "type": "string"
          },
          "by_id": {
            "type": "string"
          },
          "at": {
            "type": "string",
            "format": "date-time"
          },
          "reason": {
            "type": "string"
          },
          "self": {
            "type": "boolean",
            "description": "True if the approver was the same person who submitted (segregation-of-duties flag)."
          }
        }
      },
      "description": "Audit trail of every approval status change."
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "read": true,
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "product_manager"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "product_manager"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "product_manager"
          }
        }
      ]
    }
  }
}