{
  "name": "Category",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "name_ar": {
      "type": "string",
      "description": "Arabic display name shown when the site language is Arabic."
    },
    "slug": {
      "type": "string"
    },
    "parent_id": {
      "type": "string",
      "description": "Optional parent category id for subcategories"
    },
    "image_url": {
      "type": "string"
    },
    "sort_order": {
      "type": "number",
      "default": 0
    },
    "featured": {
      "type": "boolean",
      "default": false,
      "description": "Show this category as featured on the homepage."
    },
    "active": {
      "type": "boolean",
      "default": true,
      "description": "Inactive categories are hidden from the storefront."
    },
    "meta_title": {
      "type": "string"
    },
    "meta_description": {
      "type": "string"
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "read": true,
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "product_manager"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "product_manager"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "product_manager"
          }
        }
      ]
    }
  }
}