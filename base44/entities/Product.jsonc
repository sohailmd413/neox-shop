{
  "name": "Product",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "name_ar": {
      "type": "string",
      "description": "Arabic display name shown when the site language is Arabic."
    },
    "slug": {
      "type": "string"
    },
    "sku": {
      "type": "string"
    },
    "barcode": {
      "type": "string",
      "description": "Scannable barcode value. Auto-generated on create if left empty."
    },
    "barcode_type": {
      "type": "string",
      "enum": [
        "CODE128",
        "EAN13"
      ],
      "default": "CODE128",
      "description": "Barcode symbology. CODE128 is auto-generated; EAN13 must be entered manually."
    },
    "description": {
      "type": "string"
    },
    "description_ar": {
      "type": "string",
      "description": "Arabic long description shown on the product page in Arabic."
    },
    "short_description": {
      "type": "string"
    },
    "short_description_ar": {
      "type": "string",
      "description": "Arabic short description."
    },
    "price": {
      "type": "number"
    },
    "compare_at_price": {
      "type": "number"
    },
    "stock": {
      "type": "number",
      "default": 0
    },
    "stock_status": {
      "type": "string",
      "enum": [
        "in_stock",
        "out_of_stock",
        "preorder"
      ],
      "default": "in_stock"
    },
    "category": {
      "type": "string"
    },
    "brand": {
      "type": "string"
    },
    "images": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "inactive",
        "draft",
        "pending_approval",
        "archived",
        "out_of_stock"
      ],
      "default": "active",
      "description": "active=live on storefront; inactive=temporarily hidden (reactivate later); draft=incomplete / not yet submitted, never live; pending_approval=submitted for admin sign-off, not live yet; archived=removed from catalog, kept for history and can be restored; out_of_stock=active listing but shown as unavailable to customers. A draft can never skip straight to active \u2014 it must pass through pending_approval and be approved first."
    },
    "completion_percentage": {
      "type": "number",
      "default": 0,
      "minimum": 0,
      "maximum": 100,
      "description": "0\u2013100 share of the publish-required fields that are filled. Recomputed and stored on every save."
    },
    "last_edited_at": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp of the most recent save (draft autosave or publish). Updated on every persist."
    },
    "featured": {
      "type": "boolean",
      "default": false
    },
    "is_new_arrival": {
      "type": "boolean",
      "default": false
    },
    "is_best_seller": {
      "type": "boolean",
      "default": false
    },
    "weight": {
      "type": "number"
    },
    "dimensions": {
      "type": "string"
    },
    "shipping_class": {
      "type": "string"
    },
    "tax_class": {
      "type": "string"
    },
    "meta_title": {
      "type": "string"
    },
    "meta_description": {
      "type": "string"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "rating": {
      "type": "number",
      "default": 0
    },
    "num_reviews": {
      "type": "number",
      "default": 0
    },
    "return_days": {
      "type": "number",
      "default": 0,
      "description": "Allowed return window in days. 0 or empty means no returns allowed."
    },
    "warranty": {
      "type": "string",
      "description": "Warranty terms set by admin, e.g. '2-year manufacturer warranty'."
    },
    "sale_ends_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the current sale ends. Used to show a countdown; clearing it ends the sale."
    },
    "archived_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the product was archived. Cleared on restore."
    },
    "archived_by": {
      "type": "string",
      "description": "Name of the admin who archived the product. Cleared on restore."
    },
    "submitted_by": {
      "type": "string",
      "description": "Display name of the staff member who last submitted this product for approval."
    },
    "submitted_by_id": {
      "type": "string",
      "description": "User id of the staff member who last submitted this product for approval."
    },
    "submitted_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the product was last submitted for approval."
    },
    "rejection_reason": {
      "type": "string",
      "description": "Reason entered by the approver the last time this submission was rejected. Cleared on a new submission."
    },
    "approval_history": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "action": {
            "type": "string",
            "enum": [
              "submitted",
              "approved",
              "rejected"
            ]
          },
          "by": {
            "type": "string"
          },
          "by_id": {
            "type": "string"
          },
          "at": {
            "type": "string",
            "format": "date-time"
          },
          "reason": {
            "type": "string"
          },
          "self": {
            "type": "boolean",
            "description": "True if the approver was the same person who submitted (segregation-of-duties flag)."
          }
        }
      },
      "description": "Audit trail of every approval status change: who submitted / approved / rejected it and when."
    }
  },
  "required": [
    "name",
    "price"
  ],
  "rls": {
    "read": true,
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "product_manager"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "product_manager"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "product_manager"
          }
        }
      ]
    }
  }
}