{
  "name": "Product",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "name_ar": {
      "type": "string",
      "description": "Arabic display name shown when the site language is Arabic."
    },
    "slug": {
      "type": "string"
    },
    "sku": {
      "type": "string"
    },
    "vendor_sku": {
      "type": "string",
      "description": "The vendor's own internal reference for this product, separate from the system SKU/barcode. Vendor-editable without triggering re-approval."
    },
    "barcode": {
      "type": "string",
      "description": "Scannable barcode value. Auto-generated on create if left empty."
    },
    "barcode_type": {
      "type": "string",
      "enum": [
        "CODE128",
        "EAN13"
      ],
      "default": "CODE128",
      "description": "Barcode symbology. CODE128 is auto-generated; EAN13 must be entered manually."
    },
    "description": {
      "type": "string"
    },
    "description_ar": {
      "type": "string",
      "description": "Arabic long description shown on the product page in Arabic."
    },
    "short_description": {
      "type": "string"
    },
    "short_description_ar": {
      "type": "string",
      "description": "Arabic short description."
    },
    "price": {
      "type": "number"
    },
    "compare_at_price": {
      "type": "number"
    },
    "stock": {
      "type": "number",
      "default": 0
    },
    "stock_status": {
      "type": "string",
      "enum": [
        "in_stock",
        "out_of_stock",
        "preorder"
      ],
      "default": "in_stock"
    },
    "reorder_threshold": {
      "type": "number",
      "description": "Per-product reorder point. When stock falls at or below this number the product appears in the Low-stock action view. Blank falls back to the store's reorder_threshold_default."
    },
    "category": {
      "type": "string"
    },
    "brand": {
      "type": "string"
    },
    "vendor_id": {
      "type": "string",
      "description": "The Vendor this product is sourced from. Nullable \u2014 products with no assigned vendor are sourced internally."
    },
    "vendor_user_id": {
      "type": "string",
      "description": "The user id of the owning vendor (mirrors Vendor.user_id). Set by saveVendorProduct on create so Product read RLS can scope vendor reads to their own products without a join. Null for first-party products."
    },
    "images": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "inactive",
        "draft",
        "pending_approval",
        "rejected",
        "archived",
        "out_of_stock"
      ],
      "default": "active",
      "description": "active=live on storefront; inactive=temporarily hidden (reactivate later); draft=incomplete / not yet submitted, never live; pending_approval=submitted for admin sign-off, not live yet; rejected=returned by an approver with a reason, not live and never visible on the storefront (must be fixed and resubmitted through pending_approval); archived=removed from catalog, kept for history and can be restored; out_of_stock=active listing but shown as unavailable to customers. A draft can never skip straight to active \u2014 it must pass through pending_approval and be approved first."
    },
    "completion_percentage": {
      "type": "number",
      "default": 0,
      "minimum": 0,
      "maximum": 100,
      "description": "0\u2013100 share of the publish-required fields that are filled. Recomputed and stored on every save."
    },
    "last_edited_at": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp of the most recent save (draft autosave or publish). Updated on every persist."
    },
    "featured": {
      "type": "boolean",
      "default": false
    },
    "is_new_arrival": {
      "type": "boolean",
      "default": false
    },
    "is_best_seller": {
      "type": "boolean",
      "default": false
    },
    "weight": {
      "type": "number"
    },
    "dimensions": {
      "type": "string"
    },
    "shipping_class": {
      "type": "string"
    },
    "tax_class": {
      "type": "string"
    },
    "meta_title": {
      "type": "string"
    },
    "meta_description": {
      "type": "string"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "rating": {
      "type": "number",
      "default": 0
    },
    "num_reviews": {
      "type": "number",
      "default": 0
    },
    "return_days": {
      "type": "number",
      "default": 0,
      "description": "Allowed return window in days. 0 or empty means no returns allowed."
    },
    "warranty": {
      "type": "string",
      "description": "Warranty terms set by admin, e.g. '2-year manufacturer warranty'."
    },
    "size_chart_id": {
      "type": "string",
      "description": "Reference to a SizeChart template used for this product's size guide. Blank = no size guide shown."
    },
    "fit_notes": {
      "type": "string",
      "description": "Optional fit guidance shown in the size guide, e.g. 'Runs small \u2014 order one size up'."
    },
    "fit_notes_ar": {
      "type": "string",
      "description": "Arabic fit notes shown in the size guide when Arabic is selected."
    },
    "sale_ends_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the current sale ends. Used to show a countdown; clearing it ends the sale."
    },
    "archive_requested": {
      "type": "boolean",
      "default": false,
      "description": "True when a vendor requested archive of an active product. Surfaced in the admin Products 'Archive requests' tab for admin confirmation. Cleared when the admin archives or dismisses the request."
    },
    "archive_requested_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the vendor requested archive."
    },
    "archive_requested_by": {
      "type": "string",
      "description": "Display name of the vendor who requested archive."
    },
    "archived_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the product was archived. Cleared on restore."
    },
    "archived_by": {
      "type": "string",
      "description": "Name of the admin who archived the product. Cleared on restore."
    },
    "submitted_by": {
      "type": "string",
      "description": "Display name of the staff member who last submitted this product for approval."
    },
    "submitted_by_id": {
      "type": "string",
      "description": "User id of the staff member who last submitted this product for approval."
    },
    "submitted_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the product was last submitted for approval."
    },
    "rejection_reason": {
      "type": "string",
      "description": "Reason entered by the approver the last time this submission was rejected. Cleared on a new submission."
    },
    "approval_history": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "action": {
            "type": "string",
            "enum": [
              "submitted",
              "approved",
              "rejected"
            ]
          },
          "by": {
            "type": "string"
          },
          "by_id": {
            "type": "string"
          },
          "at": {
            "type": "string",
            "format": "date-time"
          },
          "reason": {
            "type": "string"
          },
          "self": {
            "type": "boolean",
            "description": "True if the approver was the same person who submitted (segregation-of-duties flag)."
          }
        }
      },
      "description": "Audit trail of every approval status change: who submitted / approved / rejected it and when."
    }
  },
  "required": [
    "name",
    "price"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "product_manager"
          }
        },
        {
          "user_condition": {
            "role": "delivery_manager"
          }
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "vendor"
              }
            },
            {
              "data.vendor_user_id": "{{user.id}}"
            }
          ]
        },
        {
          "data.status": "active"
        },
        {
          "data.status": "out_of_stock"
        }
      ]
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "product_manager"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "product_manager"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "product_manager"
          }
        }
      ]
    }
  }
}