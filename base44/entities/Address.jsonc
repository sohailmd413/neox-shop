{
  "name": "Address",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "line1": {
      "type": "string"
    },
    "line2": {
      "type": "string"
    },
    "city": {
      "type": "string"
    },
    "state": {
      "type": "string"
    },
    "postal_code": {
      "type": "string"
    },
    "country": {
      "type": "string"
    },
    "is_default": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "line1",
    "city",
    "country"
  ],
  "rls": {
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "create": true,
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}