{
  "name": "Address",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "label": {
      "type": "string",
      "enum": [
        "Home",
        "Work",
        "Other"
      ],
      "default": "Home",
      "description": "Address label shown in the address book."
    },
    "full_name": {
      "type": "string",
      "description": "Recipient name for this address."
    },
    "phone": {
      "type": "string",
      "description": "Contact phone for this address (for delivery coordination)."
    },
    "line1": {
      "type": "string"
    },
    "line2": {
      "type": "string"
    },
    "city": {
      "type": "string"
    },
    "state": {
      "type": "string"
    },
    "postal_code": {
      "type": "string"
    },
    "country": {
      "type": "string"
    },
    "is_default": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "line1",
    "city",
    "country"
  ],
  "rls": {
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "create": true,
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}