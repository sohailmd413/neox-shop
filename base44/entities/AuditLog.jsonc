{
  "name": "AuditLog",
  "type": "object",
  "properties": {
    "admin_id": {
      "type": "string"
    },
    "action": {
      "type": "string",
      "description": "What the staff member did, e.g. vendor_approved, vendor_rejected, product_approved, product_rejected."
    },
    "target_type": {
      "type": "string",
      "description": "Entity type acted on, e.g. Vendor, Product, Category."
    },
    "target_id": {
      "type": "string"
    }
  },
  "required": [
    "admin_id",
    "action",
    "target_type"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "product_manager"
          }
        },
        {
          "user_condition": {
            "role": "marketing_manager"
          }
        }
      ]
    }
  }
}